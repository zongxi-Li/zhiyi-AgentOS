  <diagram id="harness-self-healing" name="故障注入自愈闭环">
    <mxGraphModel dx="2022" dy="1437" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1760" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s_title" value="Harness 故障注入 + 自愈闭环时序" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="42" width="560" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s_subtitle" value="task.input.faultInjection 声明式注入，ACGExecutor 捕获 InjectedFault 后通过 Checkpoint + local_replan 完成可回放恢复" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#5f6368;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="88" width="1100" height="30" as="geometry" />
        </mxCell>

        <mxCell id="s_c_input" value="1 输入配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f8ff;strokeColor=#4f81bd;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="155" width="300" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s_input" value="AcgVisualizationView.vue&#xa;input.faultInjection = {&#xa;  step_id: risk_detect,&#xa;  fault_type: timeout,&#xa;  max_triggers: 1&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f81bd;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="85" y="215" width="240" height="130" as="geometry" />
        </mxCell>

        <mxCell id="s_c_start" value="2 启动与装备" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f3ff;strokeColor=#7e57c2;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="395" y="155" width="310" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s_arm" value="ACGExecutor.run()&#xa;validate_blueprint(blueprint)&#xa;FaultInjector.from_config(task.input.faultInjection)&#xa;Trace: RUN_STARTED(fault armed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="425" y="215" width="250" height="130" as="geometry" />
        </mxCell>

        <mxCell id="s_c_schedule" value="3 就绪集调度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1fbf7;strokeColor=#2e7d5b;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="745" y="155" width="405" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s_ready" value="_drive() 循环&#xa;_resolve_control_nodes()&#xa;ready_steps(blueprint, completed)&#xa;batch = ready[:max_parallelism]&#xa;Trace: STEP_SCHEDULED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d5b;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="775" y="215" width="165" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s_gather" value="asyncio.gather(..., return_exceptions=True)&#xa;批量执行可并行 Step&#xa;异常作为结果回收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d5b;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="965" y="215" width="155" height="130" as="geometry" />
        </mxCell>

        <mxCell id="s_c_fault" value="4 故障触发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e8;strokeColor=#c67c00;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="155" width="510" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s_execute" value="_execute_step()&#xa;STEP_STARTED&#xa;ContextAssembler.assemble()&#xa;Trace: DATA_CONSUMED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c67c00;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1220" y="215" width="150" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s_fire" value="FaultInjector.fire(node_id)&#xa;should_fire(step_id)&#xa;_triggered &lt; max_triggers&#xa;raise InjectedFault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#d93025;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1395" y="215" width="145" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s_capture" value="结果结算&#xa;isinstance(outcome, InjectedFault)&#xa;进入 _self_heal()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c67c00;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">

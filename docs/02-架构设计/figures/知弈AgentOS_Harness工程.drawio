        <mxCell id="s_recovered" value="Trace: RUN_RECOVERED&#xa;payload = {checkpointId, strategy: local_replan, recoveryCount}&#xa;WorkflowStore.save_run(run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f0;strokeColor=#d93025;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="s_failed" value="Trace: STEP_FAILED&#xa;payload = {faultType, recoverable: true}&#xa;run.recovery_count++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d93025;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="125" y="545" width="190" height="105" as="geometry" />

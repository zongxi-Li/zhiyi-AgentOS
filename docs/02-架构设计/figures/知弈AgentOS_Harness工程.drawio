        <mxCell id="s_checkpoint" value="CheckpointStore.create(run, node_id)&#xa;stateSnapshot: run / input / output / steps&#xa;outputSnapshot: 当前 Step 输出&#xa;canResume = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d93025;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="h_orchestrator" value="Orchestrator + AgentRegistry&#xa;dispatch_agent(task, run, workflow, step, memory)&#xa;行业 Pack: legal / education / programmer / writer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c67c00;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">

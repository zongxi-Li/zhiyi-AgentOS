        </mxCell>
        <mxCell id="s_reset" value="局部重规划&#xa;step.status = PENDING&#xa;step.error = None&#xa;step.retry_count += 1&#xa;run.error = None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d93025;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">

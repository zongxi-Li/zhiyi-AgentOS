          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_14" value="故障注入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d93025;fontSize=11;strokeWidth=2;" edge="1" parent="1" source="fault_prompt" target="self_heal_flow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_15" value="恢复可视化" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d93025;fontSize=11;" edge="1" parent="1" source="self_heal_flow" target="acg_observe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_16" value="扩展能力" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#3f6b63;fontSize=11;strokeWidth=2;" edge="1" parent="1" source="acg_observe" target="fed_page">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="835" y="1915" />
              <mxPoint x="248" y="1915" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_17" value="统计聚合" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#3f6b63;fontSize=11;" edge="1" parent="1" source="fed_page" target="fed_rag">

        <mxCell id="engine_langgraph" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d5b;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" value="标准合同审查：runtimeEngine=langgraph&#xa;parse_contract → classify_clauses → risk_detect → legal_evidence_match → suggestion_generate → human_review&#xa;interrupt_before=[report_generate]，审核通过后 Command(update=review) 恢复执行 report_generate" vertex="1">

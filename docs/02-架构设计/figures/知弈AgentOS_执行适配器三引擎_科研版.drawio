        </mxCell>
        <mxCell id="title" value="知弈 AgentOS 执行适配器：三种执行引擎统一治理架构" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=34;fontStyle=1;fontColor=#102033;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="2040" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="WorkflowRuntime 通过 runtimeEngine / implementationId 选择 ExecutionAdapter；三类执行路径共享 WorkflowRun、Trace、Review、Checkpoint、Store 等治理对象" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontColor=#465a70;" vertex="1" parent="1">
          <mxGeometry x="190" y="92" width="1820" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="input" value="WorkflowDefinition&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;workflowId / steps / runtimeEngine / implementationId / reviewMode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8e99a8;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#26384d;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="140" y="160" width="420" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="task" value="AgentTask + WorkflowRun&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;taskId / input / currentStepId / status / steps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8e99a8;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#26384d;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="620" y="160" width="420" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="runtime" value="WorkflowRuntime.start()&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;_resolve_workflow → create WorkflowRun → _workflow_adapter(workflow) → adapter.start()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#2d6fb8;strokeWidth=3;fontSize=18;fontStyle=1;fontColor=#123a62;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="1110" y="145" width="560" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="selector" value="Adapter Selector&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;runtime_engine = workflow.effective_runtime_engine&lt;br&gt;adapter_key = runtime_engine + ':' + implementation_id&lt;br&gt;_runtime_adapters 缓存复用&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e8;strokeColor=#c67c00;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#5a3900;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="1760" y="145" width="330" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="contract" value="ExecutionAdapter Protocol&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;start(task, run, workflow) → WorkflowRun&lt;br&gt;apply_review(decision) → WorkflowRun&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#25344a;strokeColor=#25344a;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="785" y="305" width="630" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="native_panel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#2d6fb8;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="70" y="460" width="650" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="acg_panel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0faf4;strokeColor=#2e8b57;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="775" y="460" width="650" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="lg_panel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5e8;strokeColor=#d48622;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="1480" y="460" width="650" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="native_head" value="Engine A：NativeWorkflowAdapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d6fb8;strokeColor=#2d6fb8;fontColor=#ffffff;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="95" y="485" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="native_use" value="适用对象&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;runtimeEngine = native&lt;br&gt;线性 YAML step 工作流&lt;br&gt;以 nextStepId / first_step_id 驱动顺序执行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a9cbed;fontSize=15;fontColor=#19324d;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="110" y="560" width="570" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="native_flow" value="核心流程&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;_start_native() → _run_until_blocked()&lt;br&gt;select_next_step(run)&lt;br&gt;dispatch_agent(task, run, workflow, step, memory)&lt;br&gt;requires_review → WAITING_REVIEW&lt;br&gt;step completed → _create_checkpoint()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a9cbed;fontSize=15;fontColor=#19324d;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="110" y="685" width="570" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="native_out" value="输出特征&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;WorkflowRun.steps 按顺序更新&lt;br&gt;Trace: STEP_STARTED / AGENT_CALLED / REVIEW_REQUIRED&lt;br&gt;Checkpoint: 每个完成或人审中断步骤保存现场&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ebff;strokeColor=#2d6fb8;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#143457;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="110" y="870" width="570" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="acg_head" value="Engine B：ACGWorkflowAdapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e8b57;strokeColor=#2e8b57;fontColor=#ffffff;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="800" y="485" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="acg_use" value="适用对象&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;runtimeEngine = acg&lt;br&gt;ACGBlueprint 图工作流&lt;br&gt;支持线性升格、认知规划、外部蓝图注入&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a8d7b8;fontSize=15;fontColor=#173520;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="815" y="560" width="570" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="acg_flow" value="核心流程&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;_start_acg() → _build_acg_blueprint()&lt;br&gt;provided blueprint / PlanningEngine / promote_workflow_to_acg&lt;br&gt;ACGExecutor.run() → validate_blueprint()&lt;br&gt;_drive(): resolve_control_nodes → ready_steps → asyncio.gather&lt;br&gt;ContextAssembler + FaultInjector + ProvenanceLedger&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a8d7b8;fontSize=15;fontColor=#173520;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="815" y="685" width="570" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="acg_out" value="输出特征&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;WorkflowRun.acgBlueprint / completedStepIds / provenance&lt;br&gt;Trace: STEP_SCHEDULED / DATA_CONSUMED / DATA_PRODUCED / RUN_RECOVERED&lt;br&gt;并行就绪集、低熵通信、自愈恢复进入同一运行视图&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddf3e5;strokeColor=#2e8b57;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#143b21;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="815" y="870" width="570" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="lg_head" value="Engine C：LangGraphAdapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d48622;strokeColor=#d48622;fontColor=#ffffff;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1505" y="485" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg_use" value="适用对象&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;runtimeEngine = langgraph&lt;br&gt;应用层 StateGraph 工作流&lt;br&gt;implementationId 映射到具体 Graph Runtime&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e5b46e;fontSize=15;fontColor=#51320c;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1520" y="560" width="570" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="lg_flow" value="核心流程&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;register_execution_adapter('langgraph', build_langgraph_adapter)&lt;br&gt;LangGraphAdapter.delegate → registry.create(implementationId)&lt;br&gt;LegalContractReviewStateGraphRuntime.start()&lt;br&gt;StateGraph.invoke / interrupt / apply_review&lt;br&gt;ContractReviewRunProjector.project(state → WorkflowRun)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e5b46e;fontSize=15;fontColor=#51320c;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1520" y="685" width="570" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="lg_out" value="输出特征&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;LangGraph state 被投影为 AgentOS WorkflowRun&lt;br&gt;Trace 同步 langgraphTraceIndex&lt;br&gt;CheckpointStore 保存完成或等待审核的节点现场&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffead0;strokeColor=#d48622;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#57320a;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1520" y="870" width="570" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="govern" value="共享治理平面：TraceStore｜CheckpointStore｜ReviewManager｜WorkflowStore｜StateMachine｜TaskManager｜AgentRegistry｜Orchestrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#25344a;strokeColor=#25344a;fontColor=#ffffff;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="1">

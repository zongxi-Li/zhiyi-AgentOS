  <diagram id="execution-adapters-detail" name="三引擎机制对比">
    <mxGraphModel dx="2200" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="d_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="2200" height="1450" as="geometry"/>
        </mxCell>
        <mxCell id="d_title" value="执行适配器三引擎机制对比：接口一致、调度语义差异化、治理结构统一" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=32;fontStyle=1;fontColor=#102033;" vertex="1" parent="1">
          <mxGeometry x="90" y="30" width="2020" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="d_proto" value="统一入口：ExecutionAdapterFactory(runtime, workflow, implementation_id) → ExecutionAdapter；Adapter 对外暴露 start() 与 apply_review()，对内选择各自调度模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#25344a;strokeColor=#25344a;fontColor=#ffffff;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="150" y="115" width="1900" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d_native_col" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#2d6fb8;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="70" y="235" width="650" height="835" as="geometry"/>
        </mxCell>
        <mxCell id="d_acg_col" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0faf4;strokeColor=#2e8b57;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="775" y="235" width="650" height="835" as="geometry"/>
        </mxCell>
        <mxCell id="d_lg_col" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5e8;strokeColor=#d48622;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="1480" y="235" width="650" height="835" as="geometry"/>
        </mxCell>
        <mxCell id="d_native_h" value="Native：线性工作流执行器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d6fb8;strokeColor=#2d6fb8;fontColor=#ffffff;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="95" y="260" width="600" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="d_native_sem" value="调度语义&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;单指针顺序执行&lt;br&gt;nextStepId / workflow.next_step_id(stepId)&lt;br&gt;每轮选择一个 PENDING 或 RETRYING 步骤&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a9cbed;fontSize=15;fontColor=#19324d;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="110" y="335" width="570" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="d_native_seq" value="执行序列&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;1. _run_until_blocked()&lt;br&gt;2. orchestrator.select_next_step(run)&lt;br&gt;3. WorkflowMemory.from_run(run)&lt;br&gt;4. orchestrator.dispatch_agent(...)&lt;br&gt;5. AGENT_CALLED trace + step.output&lt;br&gt;6. review/checkpoint/completion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a9cbed;fontSize=15;fontColor=#19324d;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="110" y="460" width="570" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="d_native_code" value="代码锚点&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;agentos/core/execution/adapters.py&lt;br&gt;NativeWorkflowAdapter&lt;br&gt;agentos/core/runtime.py&lt;br&gt;_start_native / _run_until_blocked / _apply_native_review&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a9cbed;fontSize=15;fontColor=#19324d;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="110" y="660" width="570" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="d_native_value" value="优势表达&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;适合结构稳定、步骤顺序明确的业务流；实现路径短，治理对象复用充分，便于将原有 YAML Pack 快速接入 Harness 生命周期。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ebff;strokeColor=#2d6fb8;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#143457;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="110" y="810" width="570" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="d_acg_h" value="ACG：图调度执行器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e8b57;strokeColor=#2e8b57;fontColor=#ffffff;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="800" y="260" width="600" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="d_acg_sem" value="调度语义&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;DAG 就绪集执行&lt;br&gt;Ready(C) = {step | dependency_sources(step) ⊆ C}&lt;br&gt;批次受 max_parallelism 控制&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a8d7b8;fontSize=15;fontColor=#173520;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="815" y="335" width="570" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="d_acg_seq" value="执行序列&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;1. _build_acg_blueprint()&lt;br&gt;2. validate_blueprint() 环检测与悬空依赖检查&lt;br&gt;3. _resolve_control_nodes()&lt;br&gt;4. ready_steps(blueprint, completed)&lt;br&gt;5. asyncio.gather(_execute_step...)&lt;br&gt;6. ContextAssembler / FaultInjector / ProvenanceLedger&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a8d7b8;fontSize=15;fontColor=#173520;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="815" y="460" width="570" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="d_acg_code" value="代码锚点&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;agentos/core/execution/adapters.py&lt;br&gt;ACGWorkflowAdapter&lt;br&gt;agentos/core/execution/acg_executor.py&lt;br&gt;agentos/core/acg/graph_ops.py&lt;br&gt;agentos/core/communication/assembler.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a8d7b8;fontSize=15;fontColor=#173520;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="815" y="660" width="570" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="d_acg_value" value="优势表达&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;适合需要并行分支、结构化通信、数据血缘、故障注入与自愈验证的复杂任务；图结构让执行顺序、数据来源和治理事件都具备明确解释。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddf3e5;strokeColor=#2e8b57;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#143b21;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="815" y="810" width="570" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="d_lg_h" value="LangGraph：外部图引擎桥接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d48622;strokeColor=#d48622;fontColor=#ffffff;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">

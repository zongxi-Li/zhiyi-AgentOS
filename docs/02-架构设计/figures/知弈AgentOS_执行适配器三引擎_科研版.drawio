        <mxCell id="d_lg_seq" value="执行序列&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;1. configure_execution_adapters(runtime)&lt;br&gt;2. register_execution_adapter('langgraph', build_langgraph_adapter)&lt;br&gt;3. LangGraphAdapter.delegate&lt;br&gt;4. registry.create(implementationId)&lt;br&gt;5. StateGraph runtime start / apply_review&lt;br&gt;6. ContractReviewRunProjector.project()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e5b46e;fontSize=15;fontColor=#51320c;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1520" y="460" width="570" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="d_lg_code" value="代码锚点&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;agent/app/execution/runtime.py&lt;br&gt;agent/app/execution/langgraph_adapter.py&lt;br&gt;agent/app/execution/langgraph_registry.py&lt;br&gt;agent/app/graphs/contract_review/runtime.py&lt;br&gt;agent/app/graphs/contract_review/projector.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e5b46e;fontSize=15;fontColor=#51320c;align=left;verticalAlign=middle;spacingLeft=16;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1520" y="660" width="570" height="125" as="geometry"/>

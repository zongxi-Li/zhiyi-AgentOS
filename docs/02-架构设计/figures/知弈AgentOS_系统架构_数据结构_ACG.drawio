                    <mxGeometry x="60" y="600" width="300" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="data_step" value="WorkflowStep&#xa;stepId / name / agentName / capability&#xa;status: pending/running/waiting_review/retrying/failed/completed/cancelled&#xa;input / output / error&#xa;retryCount / maxRetries / reviewRequired" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">

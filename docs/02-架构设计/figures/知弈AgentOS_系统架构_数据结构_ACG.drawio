                </mxCell>
                <mxCell id="data_agent_output" value="AgentOutput / SkillResult&#xa;AgentRegistry.resolve(domain, agentName, capability)&#xa;Agent.run(context)&#xa;output 写入 step.output&#xa;Orchestrator.compose_final_output 汇总 artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">

    <diagram id="acg-architecture" name="ACG架构图">
        <mxGraphModel dx="993" dy="766" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1760" pageHeight="1120" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="acg_title" value="ACG 动态群体智能引擎架构图" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="30" width="720" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="acg_subtitle" value="Core Native 自研 ACG：规划器产出计算图，执行器按依赖边计算就绪集，通信器按 inputSpec 低熵投递，治理链记录 Trace/Checkpoint/Review/Provenance" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#5f6368;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="42" y="72" width="1180" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="acg_planning_group" value="认知规划引擎 PlanningEngine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1fbf7;strokeColor=#2e7d5b;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="130" width="520" height="355" as="geometry"/>
                </mxCell>
                <mxCell id="acg_input" value="输入来源&#xa;用户意图 / WorkflowDefinition&#xa;domain + intent + input&#xa;可选 acgBlueprint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d5b;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="75" y="185" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="acg_intent" value="IntentParser&#xa;LLM generate_json 优先&#xa;失败回退启发式&#xa;输出 TaskSemanticProfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d5b;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="325" y="170" width="190" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="acg_template" value="TemplateMatcher&#xa;domain + intent 索引&#xa;字符 n-gram 相似度&#xa;命中阈值 ≥ 0.85" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d5b;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="75" y="335" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="acg_router" value="CognitiveRouter&#xa;能力 → Agent 绑定&#xa;能力标签匹配 + 评分&#xa;无候选时生成 ephemeral Agent&#xa;估算通信熵预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d5b;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="325" y="305" width="190" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="acg_blueprint" value="ACGBlueprint&#xa;统一计算图蓝图&#xa;graphId / taskId / objective&#xa;nodes + edges + metadata&#xa;validate_blueprint: 环检测 + 悬空依赖检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#2e7d5b;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="620" y="220" width="300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="acg_model_nodes" value="节点模型&#xa;StepNode: 最小执行单元&#xa;AgentNode: 执行责任方&#xa;SkillNode: 原子能力&#xa;MemoryNode: 长程上下文&#xa;EvidenceNode: 可信依据&#xa;ControlNode: start/end/if/loop/parallel/consensus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d5b;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">

                    <mxGeometry x="1080" y="350" width="300" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="data_edges" value="ACGEdge 类型&#xa;DEPENDENCY: 执行 DAG / 就绪集&#xa;COMMUNICATION: 数据流&#xa;CONTROL_FLOW: 分支/循环/汇聚&#xa;EXECUTION: Agent → Step&#xa;WRITE / READ: Memory&#xa;SUPPORT: Evidence → Step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d5b;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">

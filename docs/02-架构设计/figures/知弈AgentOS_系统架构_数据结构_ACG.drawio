                </mxCell>
                <mxCell id="data_planner" value="ACG 蓝图生成优先级&#xa;1. 外部传入 run.input.acgBlueprint&#xa;2. usePlanner 或无 steps → PlanningEngine&#xa;3. 默认 promote_workflow_to_acg 线性升格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1fbf7;strokeColor=#2e7d5b;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="360" y="360" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="data_profile" value="TaskSemanticProfile&#xa;primaryGoal / keyConstraints&#xa;requiredCapabilities&#xa;estimatedComplexity&#xa;domainHint / taskTypeHint&#xa;riskLevel / entropyBudget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d5b;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">

                </mxCell>
                <mxCell id="data_blueprint" value="ACGBlueprint&#xa;graphId / taskId / objective / complexityLevel&#xa;nodes: ACGNode[]&#xa;edges: ACGEdge[]&#xa;metadata: sourceWorkflowId, runtimeEngine, generatedBy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#2e7d5b;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">

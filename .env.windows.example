# Non-sensitive Windows/Docker Desktop development settings only.
KINLIN_DEPLOYMENT_ID=kinlin-win-dev-001
KINLIN_SECRETS_DIR=.secrets/kinlin-win-dev-001
KINLIN_HTTP_PORT=8080
KINLIN_BACKEND_DEBUG_PORT=18080
KINLIN_AI_DEBUG_PORT=18000
KINLIN_WINDOWS_CHOKIDAR_USEPOLLING=true
KINLIN_WINDOWS_WATCHFILES_FORCE_POLLING=true
KINLIN_WINDOWS_POLL_INTERVAL_MS=1000
KINLIN_PUBLIC_ORIGIN=http://127.0.0.1:8080

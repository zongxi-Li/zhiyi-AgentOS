FROM maven:3.9-eclipse-temurin-17

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gosu iproute2 netcat-openbsd \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "$(command -v gosu)" /usr/local/bin/su-exec \
    && groupadd --gid 10001 kinlin \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin kinlin \
    && mkdir -p /app/data/uploads /run/kinlin-secrets \
    && chown -R 10001:10001 /app /run/kinlin-secrets

COPY pom.xml .
RUN mvn -B -ntp -DskipTests dependency:go-offline \
    && mv /root/.m2 /opt/kinlin-m2 \
    && chown -R 10001:10001 /opt/kinlin-m2

COPY src ./src

COPY docker-entrypoint.sh /usr/local/bin/kinlin-entrypoint
COPY docker-entrypoint-dev.sh /usr/local/bin/kinlin-dev-entrypoint
RUN chmod 0755 /usr/local/bin/kinlin-entrypoint /usr/local/bin/kinlin-dev-entrypoint

EXPOSE 8080
EXPOSE 5005

ENTRYPOINT ["/usr/local/bin/kinlin-dev-entrypoint"]
CMD ["mvn", "spring-boot:run", \
     "-Dmaven.test.skip=true", \
     "-Dspring-boot.run.profiles=compose", \
     "-Dspring-boot.run.jvmArguments=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"]
